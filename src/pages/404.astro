---
import Layout from '../layouts/Layout.astro';
import { getWhatsAppUrl } from '../config/site';

const whatsappUrl = getWhatsAppUrl();
---

<Layout title="Halaman tidak ditemukan" noindex>
  <section
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-6 py-20"
  >
    <p class="text-primary text-sm font-semibold tracking-widest uppercase">
      404
    </p>

    <h1 class="font-heading mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
      Halaman tidak ditemukan
    </h1>

    <p class="text-muted mt-4 max-w-xl text-lg leading-relaxed">
      Alamat yang kamu buka tidak tersedia atau sudah dipindahkan. Kembali ke
      beranda untuk melanjutkan.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/"
        class="bg-primary hover:bg-primary-hover text-on-primary focus-visible:outline-primary rounded-lg px-6 py-3 font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Kembali ke beranda
      </a>

      {
        whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border text-foreground hover:border-primary hover:text-primary rounded-lg border px-6 py-3 font-semibold transition"
          >
            Hubungi via WhatsApp
          </a>
        )
      }
    </div>
  </section>
</Layout>
