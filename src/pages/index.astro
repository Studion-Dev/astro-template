---
import Layout from '../layouts/Layout.astro';
import AnimationTest from '../components/sections/AnimationTest.astro';
---

<Layout
  title="Website Starter | Astro Blueprint"
  description="Starter template Astro yang ringan, responsif, dan siap dikembangkan untuk website bisnis."
>
  <section
    class="mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-center px-6 py-20"
  >
    <p class="text-primary mb-4 text-sm font-semibold tracking-wide">
      ASTRO STARTER TEMPLATE
    </p>

    <h1
      class="font-heading max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
    >
      Fondasi website profesional yang cepat dan fleksibel.
    </h1>

    <p class="text-secondary/70 mt-6 max-w-2xl text-lg leading-relaxed">
      Template dasar untuk membangun landing page dan company profile sesuai
      kebutuhan setiap klien.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="#features"
        class="bg-primary hover:bg-primary-hover focus-visible:outline-primary rounded-lg px-6 py-3 font-semibold text-white transition focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Lihat Fondasi
      </a>
    </div>
  </section>

  <section id="features" class="bg-surface px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-heading text-3xl font-bold">Apa yang menjadi fondasi?</h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <article class="border-border rounded-xl border bg-white p-6">
          <h3 class="text-lg font-semibold">Performance</h3>
          <p class="text-secondary/70 mt-3 leading-relaxed">
            Mengutamakan HTML, CSS, dan JavaScript seperlunya.
          </p>
        </article>

        <article class="border-border rounded-xl border bg-white p-6">
          <h3 class="text-lg font-semibold">SEO & Accessibility</h3>
          <p class="text-secondary/70 mt-3 leading-relaxed">
            Struktur semantik dan metadata sebagai fondasi setiap halaman.
          </p>
        </article>

        <article class="border-border rounded-xl border bg-white p-6">
          <h3 class="text-lg font-semibold">Reusable</h3>
          <p class="text-secondary/70 mt-3 leading-relaxed">
            Struktur sederhana yang bisa disesuaikan untuk berbagai bisnis.
          </p>
        </article>
      </div>
    </div>
  </section>

  <AnimationTest />
</Layout>
