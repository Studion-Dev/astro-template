---
import { siteConfig } from '../../config/site';

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}`;
---

<header
  class="border-border bg-surface/80 sticky top-0 z-50 w-full border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="font-heading text-secondary flex items-center gap-2 text-xl font-bold tracking-tight"
      aria-label={`${siteConfig.name} - Beranda`}
    >
      <span
        class="bg-primary flex size-8 items-center justify-center rounded-lg font-bold text-white"
        aria-hidden="true"
      >
        {siteConfig.name.charAt(0)}
      </span>
      <span>{siteConfig.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Navigasi utama" class="hidden items-center gap-8 md:flex">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.href ? 'page' : undefined}
            class:list={[
              'hover:text-primary text-sm font-medium transition-colors',
              activeNav === item.href
                ? 'text-primary font-semibold'
                : 'text-slate-600',
            ]}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary hover:bg-primary-hover focus-visible:outline-primary inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Hubungi Kami
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hover:text-secondary focus-visible:outline-primary inline-flex items-center justify-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 md:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <svg
        data-menu-open-icon
        class="size-6"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>

      <svg
        data-menu-close-icon
        class="hidden size-6"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-navigation"
    aria-label="Navigasi mobile"
    class="border-border bg-surface hidden border-t px-4 pt-2 pb-6 md:hidden"
    data-mobile-menu
    inert
  >
    <div class="flex flex-col gap-3">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.href ? 'page' : undefined}
            class:list={[
              'hover:text-primary rounded-lg px-3 py-2 text-base font-medium hover:bg-slate-100',
              activeNav === item.href ? 'text-primary' : 'text-slate-700',
            ]}
            data-menu-link
          >
            {item.name}
          </a>
        ))
      }

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary hover:bg-primary-hover mt-2 flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-center text-sm font-semibold text-white"
      >
        Hubungi Kami
      </a>
    </div>
  </nav>
</header>

<script>
  function initMobileNavigation() {
    document.querySelectorAll('header').forEach((header) => {
      const toggle =
        header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const openIcon = header.querySelector<HTMLElement>(
        '[data-menu-open-icon]'
      );
      const closeIcon = header.querySelector<HTMLElement>(
        '[data-menu-close-icon]'
      );

      if (!toggle || !menu || toggle.dataset.initialized === 'true') return;

      toggle.dataset.initialized = 'true';

      const setMenuOpen = (isOpen: boolean) => {
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute(
          'aria-label',
          isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi'
        );

        menu.classList.toggle('hidden', !isOpen);
        menu.inert = !isOpen;

        openIcon?.classList.toggle('hidden', isOpen);
        closeIcon?.classList.toggle('hidden', !isOpen);
      };

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      menu
        .querySelectorAll<HTMLAnchorElement>('[data-menu-link]')
        .forEach((link) => {
          link.addEventListener('click', () => setMenuOpen(false));
        });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });

      setMenuOpen(false);
    });
  }

  initMobileNavigation();
  document.addEventListener('astro:page-load', initMobileNavigation);
</script>
