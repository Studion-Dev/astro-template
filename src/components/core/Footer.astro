---
import {
  siteConfig,
  getWhatsAppNumber,
  getWhatsAppUrl,
  getFormattedAddress,
} from '../../config/site';

const currentYear = new Date().getFullYear();
const whatsappUrl = getWhatsAppUrl();
const whatsappNumber = getWhatsAppNumber();
const address = getFormattedAddress();

const socialLinks = [
  { label: 'Instagram', href: siteConfig.social.instagram },
  { label: 'Facebook', href: siteConfig.social.facebook },
  { label: 'TikTok', href: siteConfig.social.tiktok },
  { label: 'YouTube', href: siteConfig.social.youtube },
].filter((item) => Boolean(item.href));
---

<!-- Anchor kontak default. Saat memakai pattern WhatsAppForm, pindahkan id ini
     ke section kontak tersebut supaya tidak ada ID ganda. -->
<footer
  id="kontak"
  class="border-border bg-surface text-foreground scroll-mt-24 border-t"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Brand Info -->
      <div class="space-y-4">
        <a
          href="/"
          class="font-heading flex items-center gap-2 text-xl font-bold tracking-tight"
          aria-label={`${siteConfig.name} - Beranda`}
        >
          <span
            class="bg-primary text-on-primary flex size-8 items-center justify-center rounded-lg font-bold"
            aria-hidden="true"
          >
            {siteConfig.name.charAt(0)}
          </span>
          <span>{siteConfig.name}</span>
        </a>

        <p class="text-muted max-w-sm text-sm leading-relaxed">
          {siteConfig.description}
        </p>

        {
          socialLinks.length > 0 && (
            <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
              {socialLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary text-muted transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Quick Links -->
      <nav aria-label="Navigasi footer">
        <h2
          class="font-heading mb-4 text-sm font-semibold tracking-wider uppercase"
        >
          Navigasi
        </h2>

        <ul class="space-y-2.5">
          {
            siteConfig.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-primary text-muted text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact Info -->
      <div>
        <h2
          class="font-heading mb-4 text-sm font-semibold tracking-wider uppercase"
        >
          Kontak & Lokasi
        </h2>

        <ul class="text-muted space-y-2.5 text-sm">
          {address && <li>Alamat: {address}</li>}

          {
            siteConfig.contact.hours && (
              <li>Jam operasional: {siteConfig.contact.hours}</li>
            )
          }

          {
            siteConfig.contact.phone && (
              <li>
                Telepon:{' '}
                <a
                  href={`tel:${siteConfig.contact.phone}`}
                  class="hover:text-primary transition-colors"
                >
                  {siteConfig.contact.phone}
                </a>
              </li>
            )
          }

          {
            siteConfig.contact.email && (
              <li>
                Email:{' '}
                <a
                  href={`mailto:${siteConfig.contact.email}`}
                  class="hover:text-primary break-all transition-colors"
                >
                  {siteConfig.contact.email}
                </a>
              </li>
            )
          }

          {
            whatsappUrl && (
              <li>
                WhatsApp:{' '}
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary transition-colors"
                >
                  +{whatsappNumber}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="border-border text-muted mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 text-center text-xs sm:flex-row sm:text-left"
    >
      <p>
        &copy; {currentYear}
        {siteConfig.legalName || siteConfig.name}. All rights reserved.
      </p>
      <p>Built with Astro & Tailwind CSS</p>
    </div>
  </div>
</footer>
