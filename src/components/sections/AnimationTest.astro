---
const animations = [
  {
    direction: 'left',
    title: 'Reveal From Left',
    description: 'Elemen muncul dari arah kiri.',
  },
  {
    direction: 'right',
    title: 'Reveal From Right',
    description: 'Elemen muncul dari arah kanan.',
  },
  {
    direction: 'up',
    title: 'Reveal From Bottom',
    description: 'Elemen muncul dari arah bawah.',
  },
  {
    direction: 'down',
    title: 'Reveal From Top',
    description: 'Elemen muncul dari arah atas.',
  },
];
---

<section id="animation-test" class="bg-gray-50 px-6 py-20 sm:px-10 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <p
        class="mb-3 text-sm font-semibold tracking-widest text-blue-600 uppercase"
      >
        Development Playground
      </p>

      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Animation Test
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-gray-600">
        Scroll ke bawah untuk menguji animasi reveal berbasis Intersection
        Observer.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        animations.map((animation, index) => (
          <article
            data-reveal={animation.direction}
            class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm"
            style={`transition-delay: ${index * 80}ms`}
          >
            <span class="mb-4 inline-flex rounded-lg bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700">
              {animation.direction}
            </span>

            <h3 class="text-xl font-semibold text-gray-900">
              {animation.title}
            </h3>

            <p class="mt-3 leading-relaxed text-gray-600">
              {animation.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../../script/animation.js';
</script>
