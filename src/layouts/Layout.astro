---
import SEO from '../components/core/SEO.astro';
import Navbar from '../components/core/Navbar.astro';
import Footer from '../components/core/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  lang?: string;
}

const { title, description, ogImage, canonicalURL, lang = 'id' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>

  <body
    class="bg-surface text-secondary flex min-h-screen flex-col antialiased"
  >
    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
